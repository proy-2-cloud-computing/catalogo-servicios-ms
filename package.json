{
  "name": "itsm-catalogo",
  "version": "1.0.0",
  "private": true,
  "description": "Microservicio Catalogo de Servicios de la plataforma ITSM",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "info": "serverless info --verbose",
    "print": "serverless print",
    "test": "python3 -m unittest discover -s tests -v",
    "seed:minimo": "python3 scripts/seed_catalogo.py --modo minimo",
    "seed:completo": "python3 scripts/seed_catalogo.py --modo completo",
    "verificar": "python3 scripts/verificar_conteos.py"
  },
  "devDependencies": {
    "serverless": "^4.0.0"
  }
}
